# Trinity B001: HSLM Training Container
# Zenodo Bundle v7.0 - V15 Scientific Rigor
# ECE=0.084, Brier=0.234, Model Size=385KB, d=2.6
FROM ziglang/zig:0.15.0-alpine AS build

WORKDIR /src
COPY . .

# Build HSLM training binary
RUN zig build hslm-train

# Runtime stage (minimal)
FROM alpine:3.19
COPY --from=build /src/zig-out/bin/hslm-train /usr/local/bin/
COPY --from=build /src/zig-out/lib /usr/local/lib/trinity

WORKDIR /data
ENTRYPOINT ["hslm-train"]
CMD ["--help"]

# Example usage:
# docker run -v $(pwd)/data:/data trinity-b001 \
#   hslm-train --dataset tinystories --steps 30000
