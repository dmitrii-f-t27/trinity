# Trinity B004: Queen Lotus RL Container
# ========================================
# Zenodo Bundle: B004 - Calibrated Reinforcement Learning
# Version: 7.3.0
# Date: 2026-03-27
#
# This container provides a reproducible environment for:
# - Queen Lotus RL training and evaluation
# - Calibration metrics (ECE, Brier Score)
# - RL environment simulation
#
# Usage:
#   docker build -t trinity-b004:v7.3 -f Dockerfile.B004 ../../..
#   docker run trinity-b004:v7.3 --train --episodes 1000

FROM ziglang/zig:0.15.2-alpine AS builder

WORKDIR /src

COPY . .

RUN zig build queen

FROM alpine:3.19

RUN apk add --no-cache ca-certificates

WORKDIR /src

COPY --from=builder /src/zig-out/bin/queen /usr/local/bin/

ENTRYPOINT ["queen"]
CMD ["--help"]

LABEL org.trinity.bundle="B004" \
      org.trinity.version="7.3.0" \
      org.trinity.description="Queen Lotus Calibrated RL" \
      org.trinity.doi="10.5281/zenodo.19227871"
