# Trinity B007: VSA Operations Container
# Zenodo Bundle v7.0 - V15 Scientific Rigor
# SIMD speedup=12.3x, noise resilience=94.8%, d=3.2
FROM ziglang/zig:0.15.0-alpine AS build

WORKDIR /src
COPY . .

# Build VSA library and benchmarks
RUN zig build vsa-bench

# Runtime stage
FROM alpine:3.19
COPY --from=build /src/zig-out/bin/vsa-bench /usr/local/bin/

WORKDIR /data
ENTRYPOINT ["vsa-bench"]
CMD ["--help"]
