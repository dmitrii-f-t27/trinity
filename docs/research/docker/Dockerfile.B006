# Trinity B006: Sacred Formats Container
# Zenodo Bundle v7.0 - V15 Scientific Rigor
# Storage reduction=6.2x, dedup=84%, d=2.6
FROM ziglang/zig:0.15.0-alpine AS build

WORKDIR /src
COPY . .

# Build sacred format tools
RUN zig build sacred-tools

# Runtime stage
FROM alpine:3.19
COPY --from=build /src/zig-out/bin/sacred-* /usr/local/bin/

WORKDIR /data
ENTRYPOINT ["sacred-convert"]
CMD ["--help"]
